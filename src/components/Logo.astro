---
import { SITE } from 'astrowind:config';

const name = SITE?.name || 'GutSource';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white inline-flex items-center gap-2.5"
>
  <span
    class="h-9 w-9 shrink-0 rounded-lg bg-primary text-white flex items-center justify-center text-sm font-bold tracking-tight"
    aria-hidden="true"
  >GS</span>
  <span class="hidden sm:inline tracking-tight leading-tight">
    <span class="block text-[0.95em]">{name}</span>
  </span>
  <span class="sr-only">{name}</span>
</span>
