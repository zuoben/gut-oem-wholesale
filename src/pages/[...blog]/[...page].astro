---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';
import { getBlogListMetadata } from '~/utils/blog-archive-seo';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { buildBlogCollectionSchema } from '~/utils/collection-schema';
import { BREADCRUMB_BLOG, BREADCRUMB_HOME, buildBreadcrumbList } from '~/utils/breadcrumb-schema';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const blogMeta = getBlogListMetadata(currentPage);

const metadata = {
  title: blogMeta.title,
  description: blogMeta.description,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: blogMeta.openGraph,
};

const isIndexed = blogListRobots?.index && currentPage === 1;
const archiveUrl = String(getCanonical(Astro.url.pathname));
const breadcrumbSchema = buildBreadcrumbList([
  { name: BREADCRUMB_HOME.en, path: '/' },
  { name: BREADCRUMB_BLOG.en, path: '/blog' },
]);
const collectionSchema = isIndexed
  ? buildBlogCollectionSchema({
      name: blogMeta.title,
      description: blogMeta.description,
      url: archiveUrl,
      posts: page.data.map((post) => ({
        title: post.title,
        url: String(getCanonical(getPermalink(post.permalink, 'post'))),
      })),
    })
  : null;
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="B2B sourcing guides for custom digestive enzymes & probiotics sets, wholesale MOQ, private label packaging, and factory-direct OEM — written for brands, retailers, clubs, and gift sellers."
    >
      digestive enzymes & probiotics OEM Blog
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>

  {collectionSchema && <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
