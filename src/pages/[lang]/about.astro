---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { buildAboutPageSchema, buildOrganizationSchema } from '~/utils/organization-schema';
import { getAboutCopy } from '~/i18n/copy-pages';
import { LOCALE_META, localizePath, type Locale } from '~/i18n/locales';

import type { GetStaticPaths } from 'astro';
import { I18N_LOCALES } from '~/i18n/locales';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const c = getAboutCopy(locale);
const L = (path: string) => localizePath(path, locale);

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[locale].ogLocale },
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(buildOrganizationSchema())} />
  <script type="application/ld+json" set:html={JSON.stringify(buildAboutPageSchema())} />

  <Hero
    actions={[
      { text: c.quoteCta, href: `${L('/contact')}#inquiry-form`, variant: 'primary' },
      { text: c.oemCta, href: L('/oem'), variant: 'secondary' },
    ]}
  >
    <Fragment slot="title">{c.heroTitleBefore}<span class="text-accent">{c.heroTitleAccent}</span></Fragment>
    <Fragment slot="subtitle">
      <p class="max-w-2xl mx-auto text-xl">{c.heroSub}</p>
    </Fragment>
  </Hero>

  <Features title={c.howTitle} items={c.howItems} />

  <CallToAction actions={[{ text: c.contactCta, href: `${L('/contact')}#inquiry-form`, variant: 'primary' }]}>
    <Fragment slot="title">{c.ctaTitle}</Fragment>
    <Fragment slot="subtitle">{c.ctaSub}</Fragment>
  </CallToAction>
</Layout>
