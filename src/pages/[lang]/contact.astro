---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { buildContactPageSchema } from '~/utils/organization-schema';
import { getWhatsAppUrl } from '~/utils/whatsapp';
import { getContactCopy } from '~/i18n/copy-pages';
import { getInquiryForm } from '~/i18n/forms';
import { LOCALE_META, WHATSAPP_BY_LOCALE, localizePath, type Locale } from '~/i18n/locales';

import type { GetStaticPaths } from 'astro';
import { I18N_LOCALES } from '~/i18n/locales';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const c = getContactCopy(locale);
const form = getInquiryForm(locale);
const L = (path: string) => localizePath(path, locale);
const whatsappUrl = getWhatsAppUrl(WHATSAPP_BY_LOCALE[locale]);

const channels = c.channels.map((ch) =>
  ch.icon === 'tabler:brand-whatsapp'
    ? {
        ...ch,
        description: `<a class="text-link" href="${whatsappUrl}" target="_blank" rel="noopener noreferrer">+86 183-0291-9628</a>`,
      }
    : ch
);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map(({ title, description }) => ({
    '@type': 'Question',
    name: title,
    acceptedAnswer: { '@type': 'Answer', text: description.replace(/<[^>]+>/g, '') },
  })),
};

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[locale].ogLocale },
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(buildContactPageSchema())} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Hero
    actions={[
      { text: c.sendCta, href: '#inquiry-form', variant: 'primary', icon: 'tabler:send' },
      { text: c.waCta, href: whatsappUrl, target: '_blank' },
    ]}
  >
    <Fragment slot="title">
      {c.heroTitleBefore}<span class="text-accent">{c.heroTitleAccent}</span>
    </Fragment>
    <Fragment slot="subtitle">
      <p class="max-w-2xl mx-auto" set:html={c.heroSub} />
    </Fragment>
  </Hero>

  <ContactUs
    id="inquiry-form"
    title={c.formTitle}
    subtitle={c.formSub}
    compact
    inputs={form.inputs}
    textarea={form.textarea}
    disclaimer={form.disclaimer}
    button={form.button}
    description={form.description}
  />

  <Features2 tagline={c.channelsTag} title={c.channelsTitle} items={channels} />

  <FAQs title={c.faqTitle} items={c.faqs} />

  <CallToAction
    actions={[
      { text: c.oemPage, href: L('/oem'), variant: 'secondary' },
      { text: c.wholesalePage, href: L('/wholesale'), variant: 'secondary' },
    ]}
  >
    <Fragment slot="title">{c.ctaTitle}</Fragment>
    <Fragment slot="subtitle">{c.ctaSub}</Fragment>
  </CallToAction>
</Layout>
