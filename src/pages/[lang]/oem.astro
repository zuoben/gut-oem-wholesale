---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import { getOemCopy } from '~/i18n/copy-home';
import { getInquiryForm } from '~/i18n/forms';
import { LOCALE_META, localizePath, type Locale } from '~/i18n/locales';

import type { GetStaticPaths } from 'astro';
import { I18N_LOCALES } from '~/i18n/locales';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const c = getOemCopy(locale);
const form = getInquiryForm(locale);
const L = (path: string) => localizePath(path, locale);

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[locale].ogLocale },
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { text: c.startCta, href: '#inquiry-form', variant: 'primary', icon: 'tabler:send' },
      { text: c.wholesaleInstead, href: L('/wholesale'), variant: 'secondary' },
    ]}
  >
    <Fragment slot="title">
      {c.heroTitleBefore}<span class="text-accent">{c.heroTitleAccent}</span>
    </Fragment>
    <Fragment slot="subtitle">
      <p class="max-w-2xl mx-auto text-xl">{c.heroSub}</p>
    </Fragment>
  </Hero>

  <Features id="enzymes" tagline={c.capTag} title={c.capTitle} items={c.capItems} />

  <section id="probiotics" class="sr-only" aria-hidden="true">Probiotics OEM</section>
  <section id="fiber" class="sr-only" aria-hidden="true">Fiber powder OEM</section>

  <Features
    id="examples"
    tagline={c.examplesTag}
    title={c.examplesTitle}
    subtitle={c.examplesSub}
    columns={2}
    items={c.examplesItems}
  />
  <div class="mx-auto max-w-5xl px-6 -mt-4 mb-10">
    <a href={L('/products')} class="btn-primary">{c.examplesCta}</a>
  </div>

  <Steps title={c.pathTitle} items={c.pathSteps} />

  <FAQs title={c.faqTitle} items={c.faqs} />

  <ContactUs
    id="inquiry-form"
    title={c.formTitle}
    subtitle={c.formSub}
    compact
    inputs={form.inputs}
    textarea={form.textarea}
    disclaimer={form.disclaimer}
    button={form.button}
    description={form.description}
  />

  <CallToAction actions={[{ text: c.wholesaleChannel, href: L('/wholesale'), variant: 'secondary' }]}>
    <Fragment slot="title">{c.ctaTitle}</Fragment>
    <Fragment slot="subtitle">{c.ctaSub}</Fragment>
  </CallToAction>
</Layout>
