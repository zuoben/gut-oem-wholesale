---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { products, getProductBySlug } from '~/data/products';
import { BREADCRUMB_HOME, BREADCRUMB_PRODUCTS, buildBreadcrumbList } from '~/utils/breadcrumb-schema';
import { getProductsCopy } from '~/i18n/copy-pages';
import { getCategoryLabel, getLocalizedProduct } from '~/i18n/products-i18n';
import { LOCALE_META, localizePath, type Locale } from '~/i18n/locales';

import type { GetStaticPaths } from 'astro';
import { I18N_LOCALES } from '~/i18n/locales';

export const getStaticPaths = (() =>
  I18N_LOCALES.flatMap((lang) =>
    products.map((product) => ({
      params: { lang, slug: product.slug },
    }))
  )) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const c = getProductsCopy(locale);
const d = c.detail;
const L = (path: string) => localizePath(path, locale);

const { slug } = Astro.params;
const product = getProductBySlug(slug!);

if (!product) {
  return Astro.redirect(L('/products'));
}

const loc = getLocalizedProduct(locale, product);

const metadata = {
  title: `${loc.name} | OEM Example | GutSource`,
  description: `${loc.name} — representative ${getCategoryLabel(locale, product.category).toLowerCase()} OEM capability example. B2B inquiry only; structure/function dietary supplements.`,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[locale].ogLocale },
};

const breadcrumbSchema = buildBreadcrumbList([
  { name: BREADCRUMB_HOME[locale], path: L('/') },
  { name: BREADCRUMB_PRODUCTS[locale], path: L('/products') },
  { name: loc.name, path: L(`/products/${product.slug}`) },
]);

const inquiryHref = `${L('/contact')}?looking=OEM%2FPrivate%20label#inquiry-form`;
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="mx-auto max-w-6xl px-6 pt-10 pb-4">
    <nav class="text-sm text-muted mb-6">
      <a href={L('/')} class="hover:text-primary">{d.home}</a>
      <span class="mx-2">/</span>
      <a href={L('/products')} class="hover:text-primary">{d.products}</a>
      <span class="mx-2">/</span>
      <span class="text-default">{loc.name}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
      <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800">
        <img
          src={product.image}
          alt={loc.name}
          width="800"
          height="600"
          class="w-full h-auto object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary mb-2">
          {getCategoryLabel(locale, product.category)} · {loc.format}
        </p>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-2 dark:text-white">{loc.name}</h1>
        <p class="text-muted mb-6">{product.nameZh}</p>

        <div class="mb-6">
          <h2 class="text-lg font-semibold mb-3 dark:text-white">{d.specsTitle}</h2>
          <ul class="list-disc pl-5 space-y-1 text-muted">
            {loc.specs.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>

        <div class="mb-6">
          <h2 class="text-lg font-semibold mb-3 dark:text-white">{d.sellingTitle}</h2>
          <ul class="list-disc pl-5 space-y-1 text-muted">
            {loc.sellingPoints.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>

        <p class="text-sm text-muted border-l-4 border-teal-400/60 pl-4 mb-8">{d.sourceNote}</p>

        <div class="flex flex-wrap gap-3">
          <a href={inquiryHref} class="btn-primary">{d.inquireOem}</a>
          <a href={L('/wholesale')} class="btn-secondary">{d.wholesale}</a>
          <a href={L('/products')} class="btn btn-tertiary">{d.allExamples}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-6">
    <div class="rounded-xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-5 py-4 text-sm text-muted">
      <strong class="text-default">{d.complianceStrong}</strong> {d.compliance}
    </div>
  </section>

  <CallToAction
    actions={[
      { text: d.contactCta, href: `${L('/contact')}#inquiry-form`, variant: 'primary' },
      { text: d.oemPrograms, href: L('/oem'), variant: 'secondary' },
    ]}
  >
    <Fragment slot="title">{d.ctaTitle}</Fragment>
    <Fragment slot="subtitle">{d.ctaSub}</Fragment>
  </CallToAction>
</Layout>
