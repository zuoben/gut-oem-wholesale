---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { products, type ProductCategory } from '~/data/products';
import { BREADCRUMB_HOME, BREADCRUMB_PRODUCTS, buildBreadcrumbList } from '~/utils/breadcrumb-schema';
import { getProductsCopy } from '~/i18n/copy-pages';
import { getCategoryLabel, getLocalizedProduct } from '~/i18n/products-i18n';
import { LOCALE_META, localizePath, type Locale } from '~/i18n/locales';

import type { GetStaticPaths } from 'astro';
import { I18N_LOCALES } from '~/i18n/locales';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const c = getProductsCopy(locale);
const L = (path: string) => localizePath(path, locale);
const pagePath = L('/products');

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[locale].ogLocale },
};

const breadcrumbSchema = buildBreadcrumbList([
  { name: BREADCRUMB_HOME[locale], path: L('/') },
  { name: BREADCRUMB_PRODUCTS[locale], path: pagePath },
]);

const categoryOrder: ProductCategory[] = ['enzyme', 'probiotic', 'fiber'];
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Hero
    tagline={c.tagline}
    actions={[
      { variant: 'primary', text: c.quoteCta, href: `${L('/contact')}#inquiry-form`, icon: 'tabler:send' },
      { text: c.oemCta, href: L('/oem') },
    ]}
  >
    <Fragment slot="title">
      {c.heroTitleBefore}<span class="text-accent dark:text-white">{c.heroTitleAccent}</span>
    </Fragment>
    <Fragment slot="subtitle">
      <p class="max-w-2xl mx-auto text-xl">{c.heroSub}</p>
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-5xl px-6 pb-2">
    <div class="rounded-xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-5 py-4 text-sm text-muted">
      <strong class="text-default">{c.noteStrong}</strong>{' '}
      <Fragment set:html={c.note} />
    </div>
  </section>

  {
    categoryOrder.map((cat) => {
      const items = products.filter((p) => p.category === cat);
      if (!items.length) return null;
      return (
        <section class="mx-auto max-w-6xl px-6 py-10">
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6 dark:text-white">
            {getCategoryLabel(locale, cat)}
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((product) => {
              const loc = getLocalizedProduct(locale, product);
              return (
                <a
                  href={L(`/products/${product.slug}`)}
                  class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow"
                >
                  <div class="aspect-[4/3] bg-slate-50 dark:bg-slate-800 overflow-hidden">
                    <img
                      src={product.image}
                      alt={loc.name}
                      width="640"
                      height="480"
                      class="h-full w-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="flex flex-1 flex-col gap-2 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-primary">
                      {getCategoryLabel(locale, product.category)} · {loc.format}
                    </p>
                    <h3 class="text-lg font-semibold leading-snug dark:text-white group-hover:text-primary transition-colors">
                      {loc.name}
                    </h3>
                    <p class="text-sm text-muted line-clamp-2">{loc.specs.join(' · ')}</p>
                    <span class="mt-auto pt-2 text-sm font-medium text-primary">{c.viewDetails}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })
  }

  <CallToAction
    actions={[
      { text: c.oemCta2, href: L('/oem'), variant: 'primary' },
      { text: c.wholesaleCta, href: L('/wholesale'), variant: 'secondary' },
      { text: c.contactCta, href: `${L('/contact')}#inquiry-form` },
    ]}
  >
    <Fragment slot="title">{c.ctaTitle}</Fragment>
    <Fragment slot="subtitle">{c.ctaSub}</Fragment>
  </CallToAction>
</Layout>
