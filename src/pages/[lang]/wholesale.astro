---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import { getWholesaleCopy } from '~/i18n/copy-home';
import { getInquiryForm } from '~/i18n/forms';
import { LOCALE_META, localizePath, type Locale } from '~/i18n/locales';

import type { GetStaticPaths } from 'astro';
import { I18N_LOCALES } from '~/i18n/locales';

export const getStaticPaths = (() => I18N_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const c = getWholesaleCopy(locale);
const form = getInquiryForm(locale);
const L = (path: string) => localizePath(path, locale);

const metadata = {
  title: c.title,
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[locale].ogLocale },
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { text: c.priceCta, href: '#inquiry-form', variant: 'primary', icon: 'tabler:file-invoice' },
      { text: c.oemCta, href: L('/oem'), variant: 'secondary' },
    ]}
  >
    <Fragment slot="title">
      {c.heroTitleBefore}<span class="text-accent">{c.heroTitleAccent}</span>
    </Fragment>
    <Fragment slot="subtitle">
      <p class="max-w-2xl mx-auto text-xl">{c.heroSub}</p>
    </Fragment>
  </Hero>

  <Features tagline={c.assortmentTag} title={c.assortmentTitle} items={c.assortmentItems} />

  <Features2 title={c.applyTitle} columns={3} items={c.applyItems} />

  <FAQs title={c.faqTitle} items={c.faqs} />

  <ContactUs
    id="inquiry-form"
    title={c.formTitle}
    subtitle={c.formSub}
    compact
    inputs={form.inputs}
    textarea={form.textarea}
    disclaimer={form.disclaimer}
    button={form.button}
    description={form.description}
  />

  <CallToAction actions={[{ text: c.needCustom, href: L('/oem'), variant: 'secondary' }]}>
    <Fragment slot="title">{c.ctaTitle}</Fragment>
    <Fragment slot="subtitle">{c.ctaSub}</Fragment>
  </CallToAction>
</Layout>
