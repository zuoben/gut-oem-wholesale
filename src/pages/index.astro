---
import Layout from '~/layouts/PageLayout.astro';
import { getSiteUrl } from '~/utils/site-url';
import { buildOrganizationSchema, ORGANIZATION_ID } from '~/utils/organization-schema';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getHomeCopy } from '~/i18n/copy-home';
import { LOCALE_META, localizePath, type Locale } from '~/i18n/locales';

const locale: Locale = 'en';
const c = getHomeCopy(locale);
const siteUrl = getSiteUrl();
const L = (path: string) => localizePath(path, locale);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'GutSource',
  url: `${siteUrl}${L('/')}`,
  description: c.webDesc,
  inLanguage: LOCALE_META[locale].htmlLang,
  publisher: { '@id': ORGANIZATION_ID },
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteUrl}${L('/')}#webpage`,
  url: `${siteUrl}${L('/')}`,
  name: c.webName,
  isPartOf: { '@type': 'WebSite', url: `${siteUrl}${L('/')}` },
  about: { '@id': ORGANIZATION_ID },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map(({ title, description }) => ({
    '@type': 'Question',
    name: title,
    acceptedAnswer: { '@type': 'Answer', text: description.replace(/<[^>]+>/g, '') },
  })),
};

const metadata = {
  title: c.webName, // GEO: brand GutSource in <title> (matches JSON-LD / llms.txt)
  description: c.description,
  ignoreTitleTemplate: true,
  openGraph: { locale: LOCALE_META[locale].ogLocale },
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(buildOrganizationSchema())} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Hero
    actions={[
      { text: c.oemCta, href: L('/oem'), variant: 'primary', icon: 'tabler:building-factory-2' },
      { text: c.wholesaleCta, href: L('/wholesale'), variant: 'secondary', icon: 'tabler:building-store' },
    ]}
  >
    <Fragment slot="title">
      {c.heroTitleBefore}<span class="text-accent dark:text-white">{c.heroTitleAccent}</span>
    </Fragment>
    <Fragment slot="subtitle">
      <p class="text-xl hero-description max-w-3xl mx-auto" set:html={c.heroSub} />
      <p class="mt-4 text-sm text-muted max-w-2xl mx-auto">{c.heroNote}</p>
    </Fragment>
  </Hero>

  <section id="compliance" class="mx-auto max-w-5xl px-6 py-6">
    <div class="rounded-xl border border-amber-200 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-800 px-5 py-4 text-sm text-muted">
      <strong class="text-default">{c.complianceStrong}</strong>{' '}
      <Fragment set:html={c.compliance} />
    </div>
  </section>

  <Features id="value" tagline={c.valueTag} title={c.valueTitle} items={c.valueItems} />

  <section id="product-examples" class="mx-auto max-w-5xl px-6 py-10">
    <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-8 md:px-10">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary mb-2">{c.examplesKicker}</p>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3 dark:text-white">{c.examplesTitle}</h2>
      <p class="text-muted mb-5 max-w-3xl">{c.examplesBody}</p>
      <a href={L('/products')} class="btn-primary">{c.examplesCta}</a>
    </div>
  </section>

  <Features2 tagline={c.entranceTag} title={c.entranceTitle} columns={2} items={c.entranceItems} />

  <Steps
    title={c.stepsTitle}
    items={c.steps}
    callToAction={{ text: c.stepsCta, href: `${L('/contact')}#inquiry-form` }}
  />

  <FAQs id="faq" title={c.faqTitle} items={c.faqs} />

  <CallToAction
    actions={[
      { text: c.oemCta, href: L('/oem'), variant: 'primary' },
      { text: c.wholesaleCta, href: L('/wholesale'), variant: 'secondary' },
      { text: c.contactCta, href: `${L('/contact')}#inquiry-form` },
    ]}
  >
    <Fragment slot="title">{c.ctaTitle}</Fragment>
    <Fragment slot="subtitle">{c.ctaSub}</Fragment>
  </CallToAction>
</Layout>
